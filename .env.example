# monica-server-stack settings. `./monica-stack install` fills this in; to set
# up without it, fill in the blanks marked "required" and run
# `docker compose up -d`. Never commit .env.

# --- secrets (required; generate with the commands shown) ---------------------
# openssl rand -base64 32, prefixed with base64:
APP_KEY=
# openssl rand -hex 24
DB_PASSWORD=
# openssl rand -hex 32 — what MCP clients send: Authorization: Bearer <token>
MCP_BEARER_TOKEN=

# --- the first account (used once, when there's no account yet) -------------
MONICA_EMAIL=
# 8+ characters; only needed for the first start, safe to clear afterwards
MONICA_PASSWORD=
MONICA_NAME=
# e.g. GBP, EUR, USD
MONICA_CURRENCY=USD
TZ=UTC

# --- address -------------------------------------------------------------------
# The URL people open Monica at (it builds its links from this)
APP_URL=http://localhost:8080
# Where Monica and the MCP server listen on this machine
MONICA_BIND=127.0.0.1:8080
MCP_BIND=127.0.0.1:7011

# Optional HTTPS: one of caddy, tailscale, cloudflare (Monica at the domain's
# root, the MCP server at /mcp)
COMPOSE_PROFILES=
# caddy: the domain (pointing at this server) and an email for Let's Encrypt
DOMAIN=
ACME_EMAIL=
# tailscale: an auth key (admin console → Settings → Keys) and a machine name
TS_AUTHKEY=
TS_HOSTNAME=monica
# cloudflare: a tunnel token (Zero Trust → Networks → Tunnels)
CF_TUNNEL_TOKEN=

# --- email, for reminders (without it they're only logged) -------------------
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Monica

# --- optional ----------------------------------------------------------------
# API requests a minute (Monica's own default is 60)
RATE_LIMIT_PER_MINUTE_API=600
# OAuth 2.1 login for MCP clients (e.g. Authentik), as well as the bearer token
MCP_OAUTH_ISSUER=
MCP_OAUTH_CANONICAL_URL=
MCP_OAUTH_AUDIENCE=
# Run a second copy on the same machine: a prefix for its containers
# (with different MONICA_BIND / MCP_BIND)
INSTANCE_PREFIX=
