)
BN_PATH="-1,15,4 -1,15,8 0,15,2 0,16,1 0,16,2 0,17,1 0,17,4 0,17,8 0,18,4 0,18,8 0,19,4 1,19,1 1,19,2 1,20,1 1,20,2 1,20,8 1,21,4 1,21,8 1,22,4 1,22,8 2,22,2 2,23,1 2,23,2 2,24,1 2,24,4 2,24,8 2,25,4 2,25,8 2,26,4 3,26,1 3,26,2 3,26,8 4,26,2 4,26,8 5,26,2 5,26,8 6,26,2 6,26,8 7,26,2 7,26,8 8,26,2 8,26,8 9,26,2 9,26,8 9,26,4 10,26,1 10,25,2 10,25,1 10,24,2 10,24,1 10,24,4 10,23,8 10,23,4 10,22,8 11,22,2 11,22,1 11,21,2 11,21,1 11,20,2 11,20,8 11,20,4 11,19,8 11,19,4 12,19,1 12,18,2 12,18,1 12,17,2 12,17,1 12,17,4 12,16,8 12,16,4 12,15,8 13,15,2 13,15,1 13,14,2 13,14,1 12,14,4 12,13,8 12,13,4 12,12,8 12,12,2 12,12,1 12,11,2 12,11,1 12,10,2 11,10,8 11,10,4 11,9,8 11,9,4 11,9,1 11,8,2 11,8,1 11,7,2 11,7,1 10,7,4 10,6,8 10,6,4 10,5,8 10,5,2 10,5,1 10,4,2 10,4,1 10,3,2 9,3,8 9,3,4 9,3,1 8,3,4 8,3,1 7,3,4 7,3,1 6,3,4 6,3,1 5,3,4 5,3,1 4,3,4 4,3,1 3,3,4 3,3,1 3,3,2 2,3,8 2,4,4 2,4,8 2,5,4 2,5,8 2,5,2 2,6,1 2,6,2 2,7,1 1,7,4 1,7,8 1,8,4 1,8,8 1,9,4 1,9,1 1,9,2 1,10,1 1,10,2 0,10,8 0,11,4 0,11,8 0,12,4 0,12,8 0,12,2 0,13,1 0,13,2 0,14,1 -1,14,4 -1,14,8"
BN_Q=(' ' ▘ ▝ ▀ ▖ ▌ ▞ ▛ ▗ ▚ ▐ ▜ ▄ ▙ ▟ █)
read -ra BN_RING <<<"$BN_PATH"
# banner_rows K: the banner's rows, with the arrows K quarter cells round the
# ring from where they start. Each arrow is a run of quarter cells, bright at
# its head and darker behind; the ring is otherwise empty.
banner_rows() {
  local k="$1" n=${#BN_RING[@]} len=$(( ${#BN_RING[@]} * 3 / 10 )) o="$C_0" r c i a p cell fg bg g line
  local -A bits=() hot=()
  for a in 0 $((n / 2)); do
    for ((i = 0; i < len; i++)); do
      IFS=, read -r r c p <<<"${BN_RING[(k + a - i + 2 * n) % n]}"
      bits[$r,$c]=$(( ${bits[$r,$c]:-0} | p ))
      ((i < len / 3)) && hot[$r,$c]=1
    done
  done
  local text=("" "" "" "" "" "${C_B}monica-server-stack$o" "${C_DIM}Monica 4 with an MCP server,$o"
    "${C_DIM}in one Docker Compose project$o" "" "" "" "" "")
  for ((r = 0; r < BN_ROWS; r++)); do
    read -ra cell <<<"${BN_FACE[r]}"
    line="  "
    for ((c = 0; c < BN_COLS; c++)); do
      if [ -n "${bits[$r,$c]:-}" ]; then
        if [ -n "${hot[$r,$c]:-}" ]; then line+=$'\033[38;5;42m'; else line+=$'\033[38;5;29m'; fi
        line+="${BN_Q[${bits[$r,$c]}]}$o"
      elif [ "${cell[c]}" = - ]; then line+=" "
      else
        IFS=, read -r fg bg g <<<"${cell[c]}"
        line+=$'\033[38;5;'"$fg"m; [ "$bg" = - ] || line+=$'\033[48;5;'"$bg"m
        line+="$g$o"
      fi
    done
    printf '%s   %s\033[K\n' "$line" "${text[r]}"
  done
}
BN_TOP=2   # the banner's first screen row
BN_STEP=3  # quarter cells the arrows move per frame

BANNER_SHOWN=""
banner() {
  BANNER_SHOWN=1
  [ -n "$TTY" ] || { printf '\nmonica-server-stack\n'; return; }
  # Interactive: start on a clean screen (the old contents scrolled into the
  # scrollback, not erased), so the banner sits at the top and its arrows can
  # go round there (anim_on).
  if [ -z "$NONINTERACTIVE" ]; then
    local rows; rows=$(stty size </dev/tty 2>/dev/null | cut -d' ' -f1)
    if [[ "$rows" =~ ^[0-9]+$ ]]; then
      printf '%*s' "$rows" '' | tr ' ' '\n'; printf '\033[H\033[J'; ANIM=1
    fi
  fi
  printf '\n'
  banner_rows 0
}

# The arrows go round while the installer waits (a question, a step, a
# download), for as long as the banner is on screen: before each wait the
# terminal reports the cursor's row, and once output has reached the bottom
# (the next line scrolls the banner) they stop for good. Frames are drawn at
# the banner's fixed rows, saving and restoring the cursor, straight to the
# terminal (prompts can run inside $(...)).
ANIM="" ANIM_PID=""
anim_on() {
  [ -n "$ANIM" ] && [ -z "$ANIM_PID" ] || return 0
  local rows row _ tty
  rows=$(stty size </dev/tty 2>/dev/null | cut -d' ' -f1)
  # echo off first: the reply can arrive before read starts, and would show
  tty=$(stty -g </dev/tty 2>/dev/null) && stty -echo </dev/tty 2>/dev/null
  printf '\033[6n' >/dev/tty
  IFS='[;' read -rs -d R -t 0.5 _ row _ </dev/tty 2>/dev/null
  [ -n "$tty" ] && stty "$tty" </dev/tty 2>/dev/null
  if ! [[ "$rows" =~ ^[0-9]+$ && "$row" =~ ^[0-9]+$ ]] || [ "$row" -ge "$rows" ]; then
    ANIM=""; return 0
  fi
  (
    trap 'exit 0' TERM
    local k=0 n=${#BN_RING[@]}
    while :; do
      k=$(((k + BN_STEP) % n))
      printf '\x1b7\033[%d;1H%s\x1b8' "$BN_TOP" "$(banner_rows "$k")" >/dev/tty
      sleep 0.1
    done
  ) &
  ANIM_PID=$!
}
# Stop going round, back on the logo (the banner hasn't moved: anim_on checked).
anim_off() {
  [ -n "$ANIM_PID" ] || return 0
  anim_stop
  printf '\x1b7\033[%d;1H%s\x1b8' "$BN_TOP" "$(banner_rows 0)" >/dev/tty
}
anim_stop() {
  [ -n "$ANIM_PID" ] || return 0
  kill "$ANIM_PID" 2>/dev/null; wait "$ANIM_PID" 2>/dev/null; ANIM_PID=""
}

usage() {
  cat <<'USAGE'
Usage: monica-stack [--dir PATH] <command> [options]

  install             set up (or repair) this install: asks a few questions,
                      writes .env, then docker compose up -d
  status              containers, the MCP server, the API token
  logs [SERVICE] [-f] recent logs (monica, cron, db, setup, mcp, caddy, …)
  restart [SERVICE]   restart one service, or everything
  endpoint [--show-token]
                      the MCP server's address and bearer token
  token               replace the MCP's Monica API token
  backup [FILE]       database, files and .env in one archive (in backups/)
  restore FILE        put a backup back (replaces the current data)
  update              git pull, then rebuild and restart on the new version
  uninstall [--yes]   stop and remove the containers; data is kept unless asked
  link [NAME]         put this command on PATH (/usr/local/bin)

Without questions (for scripts): install --yes with --email, --name,
--password-env VAR, --tz, --currency, --https none|caddy|tailscale|cloudflare|proxy,
--domain, --url, --acme-email; secrets (TS_AUTHKEY, CF_TUNNEL_TOKEN) from the
environment.
USAGE
}

# --- which install ---------------------------------------------------------------

DIR=""
if [ "${1:-}" = "--dir" ]; then DIR="${2:?--dir needs a path}"; shift 2; fi
DIR="${DIR:-${MONICA_STACK_DIR:-}}"
[ -n "$DIR" ] || DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
[ -f "$DIR/compose.yml" ] && [ -f "$DIR/setup/setup.php" ] || die "$DIR is not a monica-server-stack folder (use --dir)"
cd "$DIR"
ROOT="$(pwd)"
mkdir -p data
LOG="$ROOT/data/monica-stack.log"
ME="$0"
[ "$(command -v "$(basename "$0")" 2>/dev/null)" = "$0" ] && ME="$(basename "$0")"
P=""

# .env read as data, the way Compose reads it (KEY=value, quotes optional),
# never run as a script: a value with a space or a $ in it is just a value
load_env() {
  local line k v
  if [ -f .env ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      [[ "$line" =~ ^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]] || continue
      k="${BASH_REMATCH[1]}"; v="${BASH_REMATCH[2]}"
      if [[ "$v" =~ ^\"(.*)\"[[:space:]]*$ ]] || [[ "$v" =~ ^\'(.*)\'[[:space:]]*$ ]]; then v="${BASH_REMATCH[1]}"; fi
      export "$k=$v"
    done < .env
  fi
  P="${INSTANCE_PREFIX:-}"
}

# set_env FILE KEY VALUE [force] — replaces KEY= in FILE, only if currently
# empty unless "force"; values are quoted, since the file gets sourced
set_env() {
  local file="$1" key="$2" val="$3" force="${4:-}"
  touch "$file"
  if grep -q "^${key}=" "$file"; then
    if [ -n "$force" ] || [ -z "$(grep "^${key}=" "$file" | cut -d= -f2- | tr -d '"')" ]; then
      local tmp; tmp="$(mktemp)"
      K="$key" V="\"$val\"" awk 'index($0, ENVIRON["K"]"=")==1 { print ENVIRON["K"]"="ENVIRON["V"]; next } { print }' "$file" > "$tmp"
      cat "$tmp" > "$file" && rm -f "$tmp"
    fi
  else
    echo "${key}=\"${val}\"" >> "$file"
  fi
}
env_get() { grep "^$1=" .env 2>/dev/null | tail -1 | cut -d= -f2- | sed 's/^"//; s/"$//'; }

dc() { docker compose "$@"; }
require_installed() {
  load_env
  [ -n "${APP_KEY:-}" ] && docker container inspect "${P}monica" >/dev/null 2>&1 || die "this install isn't set up yet — run: $ME install"
}
kv() { printf '    %s%-14s%s %s\n' "$C_DIM" "$1" "$C_0" "$2"; }
until_ok() { local n="$1"; shift; for _ in $(seq 1 "$n"); do "$@" >/dev/null 2>&1 && return 0; sleep 2; done; return 1; }
# host:port → a URL on this machine
local_url() { local b="$1"; b="${b/0.0.0.0/127.0.0.1}"; [[ "$b" == *:* ]] || b="127.0.0.1:$b"; echo "http://$b"; }
mcp_url() { echo "$(local_url "${MCP_BIND:-127.0.0.1:7011}")"; }

# --- install -----------------------------------------------------------------------

guess_tz() {
  local tz=""
  tz="$(timedatectl show -p Timezone --value 2>/dev/null || true)"
  [ -n "$tz" ] || tz="$(cat /etc/timezone 2>/dev/null || true)"
  [ -n "$tz" ] || tz="$(readlink /etc/localtime 2>/dev/null | sed 's|.*/zoneinfo/||')"
  echo "${tz:-UTC}"
}
guess_currency() {
  case "$1" in
    Europe/London|Europe/Belfast) echo GBP ;;
    Europe/Zurich) echo CHF ;;
    Europe/Stockholm) echo SEK ;; Europe/Oslo) echo NOK ;; Europe/Copenhagen) echo DKK ;;
    Europe/*) echo EUR ;;
    America/Toronto|America/Vancouver|America/Montreal) echo CAD ;;
    Australia/*) echo AUD ;; Asia/Tokyo) echo JPY ;; Asia/Kolkata) echo INR ;;
    *) echo USD ;;
  esac
}

choose_https() {
  local choice
  say "Address"
  cat <<EOM

  ${C_ACC}1${C_0}  ${C_B}This machine only${C_0}        http://localhost:${MONICA_BIND##*:} (elsewhere: an SSH tunnel)
  ${C_ACC}2${C_0}  ${C_B}A domain, with HTTPS${C_0}     Caddy and Let's Encrypt; the domain must point here
  ${C_ACC}3${C_0}  ${C_B}Tailscale${C_0}                https://<name>.<tailnet>.ts.net, private to a tailnet
  ${C_ACC}4${C_0}  ${C_B}Cloudflare Tunnel${C_0}        a domain on Cloudflare, no open ports
  ${C_ACC}5${C_0}  ${C_B}A reverse proxy${C_0}          one already running here forwards a domain

EOM
  ask "Choice [1]: " choice https
  case "${choice:-1}" in
    1|none) set_env .env COMPOSE_PROFILES "" force; set_env .env APP_URL "http://localhost:${MONICA_BIND##*:}" force ;;
    2|caddy)
      local d e; need domain "the domain"; ask "Domain (e.g. monica.example.com): " d domain; [ -n "$d" ] || die "a domain is needed"
      ask "Email for Let's Encrypt (renewal notices): " e acme-email
      set_env .env COMPOSE_PROFILES caddy force; set_env .env DOMAIN "$d" force; set_env .env ACME_EMAIL "$e" force
      set_env .env APP_URL "https://$d" force ;;
    3|tailscale)
      local k h; ask_secret "Tailscale auth key (hidden; admin console → Settings → Keys): " k TS_AUTHKEY
      [ -n "$k" ] || die "an auth key is needed (TS_AUTHKEY)"
      ask "Machine name on the tailnet [monica]: " h ts-hostname
      set_env .env COMPOSE_PROFILES tailscale force; set_env .env TS_AUTHKEY "$k" force; set_env .env TS_HOSTNAME "${h:-monica}" force
      set_env .env APP_URL "https://${h:-monica}.ts.net" force ;;   # corrected once the tailnet's name is known
    4|cloudflare)
      local t d; ask_secret "Tunnel token (hidden; Zero Trust → Networks → Tunnels): " t CF_TUNNEL_TOKEN
      [ -n "$t" ] || die "a tunnel token is needed (CF_TUNNEL_TOKEN)"
      need domain "the domain"; ask "Its public hostname (e.g. monica.example.com): " d domain
      set_env .env COMPOSE_PROFILES cloudflare force; set_env .env CF_TUNNEL_TOKEN "$t" force; set_env .env DOMAIN "$d" force
      set_env .env APP_URL "https://$d" force
      info "In Cloudflare, route $d to http://monica:80, and $d/mcp to http://monica-mcp:8080." ;;
    5|proxy)
      local u; need url "the public URL"; ask "Public URL (e.g. https://monica.example.com): " u url
      [[ "$u" == http*://* ]] || die "the URL should start with https:// (or http://)"
      set_env .env COMPOSE_PROFILES "" force; set_env .env APP_URL "${u%/}" force
      info "Point the proxy at $(local_url "${MONICA_BIND:-127.0.0.1:8080}") for Monica and $(mcp_url) for /mcp." ;;
    *) die "not a choice: $choice" ;;
  esac
}

choose_mail() {
  local ans h p u pw f
  say "Email ${C_DIM}(optional)${C_0}"
  info "Monica emails reminders and birthday notices. Without mail settings they're only logged."
  ask "Set up an SMTP server for that now? [y/N] " ans mail
  case "$ans" in [yY]*) ;; *) set_env .env MAIL_MAILER log; return ;; esac
  ask "SMTP host: " h smtp-host; ask "Port [587]: " p smtp-port; ask "Username: " u smtp-user
  ask_secret "Password (hidden): " pw SMTP_PASSWORD; ask "From address: " f smtp-from
  set_env .env MAIL_MAILER smtp force; set_env .env MAIL_HOST "$h" force; set_env .env MAIL_PORT "${p:-587}" force
  set_env .env MAIL_USERNAME "$u" force; set_env .env MAIL_PASSWORD "$pw" force; set_env .env MAIL_FROM_ADDRESS "$f" force
}

compose_images() { awk '/^ *image: / && !/monica-mcp/ {print $2}' compose.yml | sort -u; }

cmd_install() {
  command -v docker >/dev/null 2>&1 || die "docker is not installed. See https://docs.docker.com/engine/install/"
  local cv; cv="$(docker compose version --short 2>/dev/null | sed 's/^v//')" || die "docker compose (v2 plugin) is required"
  printf '%s\n2.24.0\n' "$cv" | sort -V -C 2>/dev/null && [ "$cv" != 2.24.0 ] && die "docker compose $cv is too old; 2.24 or newer is needed"
  command -v openssl >/dev/null 2>&1 || die "openssl is required to generate secrets"

  banner
  info "$ROOT"
  say "Configuration"
  if [ ! -f .env ]; then cp .env.example .env; ok "Created .env"; else ok "Using the existing .env"; fi
  chmod 600 .env
  load_env
  [ -n "${APP_KEY:-}" ] || { set_env .env APP_KEY "base64:$(openssl rand -base64 32)"; ok "Generated the app key"; }
  [ -n "${DB_PASSWORD:-}" ] || { set_env .env DB_PASSWORD "$(openssl rand -hex 24)"; ok "Generated the database password"; }
  [ -n "${MCP_BEARER_TOKEN:-}" ] || { set_env .env MCP_BEARER_TOKEN "$(openssl rand -hex 32)"; ok "Generated the MCP bearer token"; }

  local fresh="" generated="" email name pw tz cur name_cur
  # .env's empty settings are exported too; an empty one isn't an answer
  local v; for v in MONICA_PASSWORD TS_AUTHKEY CF_TUNNEL_TOKEN SMTP_PASSWORD; do [ -n "${!v:-}" ] || unset "$v"; done
  [ -d data/db/monica ] || fresh=1
  if [ -n "$fresh" ]; then
    say "Your account"
    email="$(env_get MONICA_EMAIL)"
    if [ -z "$email" ]; then need email "the account's email"; ask "Email (the login): " email email; fi
    [[ "$email" == *@*.* ]] || die "that doesn't look like an email address"
    local cur_name; cur_name="$(env_get MONICA_NAME)"
    ask "Your name${cur_name:+ [$cur_name]}: " name name
    pw="$(env_get MONICA_PASSWORD)"
    [ -n "$pw" ] || pw="$PRESET_PASSWORD"
    if [ -z "$pw" ]; then
      ask_secret "Password (hidden, 8+ characters; blank to generate one): " pw MONICA_PASSWORD
      if [ -z "$pw" ]; then pw="$(openssl rand -base64 18 | tr -d '/+=' | cut -c1-16)"; generated=1; fi
      [ "${#pw}" -ge 8 ] || die "the password needs 8 or more characters"
    fi
    tz="$(guess_tz)"; ask "Timezone [$tz]: " cur tz; tz="${cur:-$tz}"
    cur="$(guess_currency "$tz")"; ask "Currency [$cur]: " name_cur currency; cur="${name_cur:-$cur}"
    set_env .env MONICA_EMAIL "$email" force; set_env .env MONICA_PASSWORD "$pw" force
    [ -n "$name" ] && set_env .env MONICA_NAME "$name" force
    set_env .env TZ "$tz" force; set_env .env MONICA_CURRENCY "${cur^^}" force
    choose_https
    choose_mail
  fi
  load_env

  say "Starting"
  local img
  for img in $(COMPOSE_PROFILES="${COMPOSE_PROFILES:-}" compose_images); do
    case "$img" in caddy*) [[ "${COMPOSE_PROFILES:-}" == *caddy* ]] || continue ;; tailscale/*) [[ "${COMPOSE_PROFILES:-}" == *tailscale* ]] || continue ;; cloudflare/*) [[ "${COMPOSE_PROFILES:-}" == *cloudflare* ]] || continue ;; esac
    pull "$img" "$img"
  done
  step "Building the MCP server" dc --progress plain build monica-mcp || die "the build failed (see above)"
  step "Starting Monica" dc --progress plain up -d --remove-orphans || die "it didn't start; see: $ME logs"
  step "First-run setup (account, API token)" until_ok 150 setup_done || die "setup didn't finish: $ME logs setup"
  [ "$(docker inspect -f '{{.State.ExitCode}}' "${P}monica-setup")" = 0 ] || { docker logs --tail 5 "${P}monica-setup" 2>&1 | sed 's/^/    /'; die "setup failed (above)"; }
  docker logs "${P}monica-setup" 2>&1 | sed -n 's/^monica-setup: /  /p' | while read -r l; do ok "$l"; done
  # the password was only for creating the account; don't keep it around
  [ -n "$(env_get MONICA_PASSWORD)" ] && set_env .env MONICA_PASSWORD "" force
  [[ "${COMPOSE_PROFILES:-}" == *tailscale* ]] && tailscale_url
  step "Waiting for the MCP server" until_ok 30 curl -sf "$(mcp_url)/health" || warn "the MCP server isn't answering yet: $ME logs mcp"

  [ -t 0 ] && [ -z "$NONINTERACTIVE" ] && offer_link
  say "Ready"
  load_env
  kv "Monica" "${APP_URL}"
  kv "Login" "${MONICA_EMAIL:-(your account)}"
  [ -n "$generated" ] && kv "Password" "${C_B}${pw}${C_0} ${C_DIM}(shown once; change it in Monica's settings)${C_0}"
  kv "MCP server" "$(mcp_url)/mcp${C_DIM}$([ -n "${COMPOSE_PROFILES:-}" ] && echo "  ·  ${APP_URL}/mcp")${C_0}"
  kv "Bearer token" "${MCP_BEARER_TOKEN:0:6}… ${C_DIM}(full: $ME endpoint --show-token)${C_0}"
  kv "Manage" "$ME status · backup · update · help"
}

setup_done() { [ "$(docker inspect -f '{{.State.Status}}' "${P}monica-setup" 2>/dev/null)" = exited ]; }

# Tailscale names the machine <name>.<tailnet>.ts.net; Monica's APP_URL has
# to match, so it's set once the tailnet is known
tailscale_url() {
  local dom=""
  for _ in $(seq 1 30); do
    dom="$(docker exec "${P}monica-tailscale" tailscale status --json 2>/dev/null | sed -n 's/.*"CertDomains": *\["\([^"]*\)".*/\1/p' | head -1)"
    [ -n "$dom" ] && break; sleep 2
  done
  [ -n "$dom" ] || { warn "Tailscale hasn't joined the tailnet yet; set APP_URL in .env once it has (https://<name>.<tailnet>.ts.net)"; return; }
  if [ "$(env_get APP_URL)" != "https://$dom" ]; then
    set_env .env APP_URL "https://$dom" force
    dc up -d monica monica-cron >/dev/null 2>&1
    ok "Tailscale address: https://$dom"
  fi
}

offer_link() {
  local name ans; name="monica-stack${P:+-${P%-}}"
  [ "$(readlink -f "/usr/local/bin/$name" 2>/dev/null)" = "$ROOT/monica-stack" ] && return 0
  echo; ask "Add a '$name' command (/usr/local/bin) to manage this install? [Y/n] " ans
  case "$ans" in [nN]*) ;; *) cmd_link "$name" && ME="$name" ;; esac
}

cmd_link() {
  local name="${1:-monica-stack${P:+-${P%-}}}"
  ln -sfn "$ROOT/monica-stack" "/usr/local/bin/$name" 2>/dev/null && ok "Added the '$name' command" || warn "couldn't write /usr/local/bin/$name (not root?)"
}

# --- day to day ----------------------------------------------------------------------

svc() {
  case "$1" in
    monica|app|web) echo monica ;; cron) echo monica-cron ;; db|database|mariadb) echo monica-db ;;
    setup) echo monica-setup ;; mcp) echo monica-mcp ;; caddy|tailscale|cloudflared) echo "$1" ;;
    "") echo "" ;; *) die "no service '$1' (monica, cron, db, setup, mcp, caddy, tailscale, cloudflared)" ;;
  esac
}

cmd_status() {
  require_installed
  say "monica-server-stack"
  kv "Folder" "$ROOT${P:+  ·  prefix $P}"
  kv "Monica" "${APP_URL:-?}"
  local h
  if curl -sf "$(mcp_url)/health" >/dev/null 2>&1; then h="${C_OK}● responding${C_0}"; else h="${C_ERR}● not responding${C_0}"; fi
  kv "MCP server" "$(mcp_url)/mcp  $h"
  say "Containers"
  dc ps -a --format '{{.Service}}\t{{.Status}}' | while IFS=$'\t' read -r s st; do
    local dot="${C_OK}●${C_0}"
    case "$st" in Exited\ \(0\)*) [ "$s" = monica-setup ] && dot="${C_DIM}○${C_0}" || dot="${C_ERR}●${C_0}" ;; Exited*|Restarting*) dot="${C_ERR}●${C_0}" ;; *unhealthy*) dot="${C_WARN}●${C_0}" ;; esac
    printf '  %s %-14s %s%s%s\n' "$dot" "$s" "$C_DIM" "$st" "$C_0"
  done
  say "API token"
  # checked now, through the MCP's own container: does Monica accept it?
  local t; t="$(docker exec "${P}monica-mcp" node -e '
    const t = require("fs").readFileSync("/data/mcp/token", "utf8").trim();
    const exp = JSON.parse(Buffer.from(t.split(".")[1], "base64url")).exp;
    fetch("http://monica/api/me", { headers: { Authorization: "Bearer " + t, Accept: "application/json" } })
      .then((r) => console.log((r.ok ? "accepted" : "refused (HTTP " + r.status + ")") + ", expires " + new Date(exp * 1000).toISOString().slice(0, 10)))
      .catch((e) => console.log("can'\''t check: " + e.message));' 2>/dev/null || echo "can't check (is monica-mcp running?)")"
  case "$t" in accepted*) ok "Monica $t" ;; *) fail "Monica's API token: $t. Get a new one: $ME token" ;; esac
}

cmd_logs() {
  require_installed
  local s="" follow=""
  for a in "$@"; do case "$a" in -f) follow=-f ;; *) s="$(svc "$a")" ;; esac; done
  dc logs --tail "${PRESET[tail]:-100}" $follow $s
}

cmd_restart() {
  require_installed
  local s; s="$(svc "${1:-}")"
  if [ -z "$s" ]; then step "Restarting everything" dc --progress plain up -d --force-recreate; else step "Restarting $s" dc restart "$s"; fi
}

cmd_endpoint() {
  require_installed
  say "MCP server"
  kv "On this machine" "$(mcp_url)/mcp"
  [ -n "${COMPOSE_PROFILES:-}" ] && kv "Public" "${APP_URL}/mcp"
  if [ "${1:-}" = "--show-token" ] || [ -n "${PRESET[show-token]:-}" ]; then kv "Bearer token" "$MCP_BEARER_TOKEN"
  else kv "Bearer token" "${MCP_BEARER_TOKEN:0:6}… ${C_DIM}(--show-token to print it)${C_0}"; fi
  info 'Clients send it as: Authorization: Bearer <token>'
}

cmd_token() {
  require_installed
  step "Replacing the MCP's API token" env MONICA_SETUP_ROTATE=1 docker compose run --rm -T monica-setup || die "couldn't: $ME logs setup"
  ok "New token in data/mcp/token; the MCP server picks it up by itself (the old one is revoked)"
}

# --- backups ---------------------------------------------------------------------------

cmd_backup() {
  require_installed
  local file="${1:-}" tmp ts; ts="$(date +%Y%m%d-%H%M%S)"
  mkdir -p backups && chmod 700 backups
  file="${file:-backups/monica-$ts.tar.gz}"
  tmp="$(mktemp -d)"
  say "Backup"
  step "Dumping the database" sh -c "docker compose exec -T monica-db sh -c 'mariadb-dump -umonica -p\"\$MARIADB_PASSWORD\" --single-transaction --routines monica' > '$tmp/monica.sql'" \
    || { rm -rf "$tmp"; die "the database dump failed"; }
  cp .env "$tmp/env"; [ -f monica.env ] && cp monica.env "$tmp/monica.env"
  step "Packing files and settings" tar -czf "$file" -C "$tmp" . -C "$ROOT/data" storage || { rm -rf "$tmp"; die "couldn't write $file"; }
  rm -rf "$tmp"; chmod 600 "$file"
  ok "Saved $file ${C_DIM}($(du -h "$file" | cut -f1); it holds the app key and passwords: keep it safe)${C_0}"
}

cmd_restore() {
  require_installed
  local file="${1:-}" ans tmp ts; ts="$(date +%Y%m%d-%H%M%S)"
  [ -f "$file" ] || die "usage: $ME restore <backup file>"
  tmp="$(mktemp -d)"; tar -xzf "$file" -C "$tmp" || die "can't read $file"
  [ -f "$tmp/monica.sql" ] && [ -f "$tmp/env" ] || { rm -rf "$tmp"; die "$file isn't a monica-stack backup"; }
  say "Restore"
  info "Replaces this install's database, files and app key with the backup's."
  ask "Go ahead? [y/N] " ans confirm
  case "$ans" in [yY]*) ;; *) rm -rf "$tmp"; info "Nothing changed."; return ;; esac
  step "Stopping Monica and the MCP server" dc stop monica monica-cron monica-mcp
  # the backup's secrets: its app key decrypts its data
  for k in APP_KEY MONICA_EMAIL MONICA_NAME MONICA_CURRENCY; do
    local v; v="$(grep "^$k=" "$tmp/env" | cut -d= -f2- | sed 's/^"//; s/"$//')"
    [ -n "$v" ] && set_env .env "$k" "$v" force
  done
  [ -f "$tmp/monica.env" ] && cp "$tmp/monica.env" monica.env
  step "Restoring the database" sh -c "docker compose exec -T monica-db sh -c 'mariadb -umonica -p\"\$MARIADB_PASSWORD\" monica' < '$tmp/monica.sql'" || die "the database restore failed"
  mv data/storage "data/storage.before-restore-$ts"
  mv "$tmp/storage" data/storage
  rm -rf "$tmp"
  ok "Files restored ${C_DIM}(the previous ones are in data/storage.before-restore-$ts)${C_0}"
  step "Starting" dc --progress plain up -d --force-recreate || die "it didn't start: $ME logs"
  step "Checking the API token" until_ok 90 setup_done || true
  docker logs "${P}monica-setup" 2>&1 | grep 'MCP token' | tail -1 | sed 's/^monica-setup: /  /'
  ok "Restored $file"
}

# --- updates ---------------------------------------------------------------------------

cmd_update() {
  require_installed
  say "Updating"
  if [ -d .git ]; then git pull --ff-only || die "git pull failed; resolve that, then run: $ME update"; else warn "Not a git checkout, so nothing to pull"; fi
  exec "$ROOT/monica-stack" --dir "$ROOT" _update ${NONINTERACTIVE:+--yes}
}

# after the pull, in the new version of this script
cmd__update() {
  require_installed
  local img; for img in $(compose_images); do pull "$img" "$img" || true; done
  step "Building the MCP server" dc --progress plain build monica-mcp || die "the build failed"
  step "Restarting on the new version" dc --progress plain up -d --remove-orphans || die "it didn't start: $ME logs"
  step "Checking setup" until_ok 90 setup_done || true
  ok "Updated"
}

cmd_uninstall() {
  load_env
  local ans="" del=""
  say "Uninstall ($ROOT)"
  info "Stops and removes this install's containers. Data stays in data/ unless chosen."
  if [ -z "$NONINTERACTIVE" ]; then ask "Continue? [y/N] " ans; case "$ans" in [yY]*) ;; *) info "Nothing removed."; return ;; esac; fi
  dc down --remove-orphans >/dev/null 2>&1 && ok "Removed the containers"
  docker image rm "${P}monica-mcp:$(sed -n 's/^ *image: .*monica-mcp:\([^ ]*\).*/\1/p' compose.yml | head -1)" >/dev/null 2>&1 || true
  for link in /usr/local/bin/*; do [ -L "$link" ] && [ "$(readlink -f "$link")" = "$ROOT/monica-stack" ] && rm -f "$link" && ok "Removed command $(basename "$link")"; done
  if [ -z "$NONINTERACTIVE" ]; then
    ask "Type 'delete' to delete all data (database, files, .env), or Enter to keep it: " del
    [ "$del" = delete ] && rm -rf data .env monica.env && ok "Deleted data/ and .env"
  fi
  say "Uninstalled"
}

# --- options and dispatch ----------------------------------------------------------------

ARGS=()
PRESET_PASSWORD=""
while [ $# -gt 0 ]; do
  case "$1" in
    --yes|-y) NONINTERACTIVE=1; PRESET[confirm]=y ;;
    --show-token) PRESET[show-token]=1 ;;
    --tail) PRESET[tail]="${2:?}"; shift ;;
    --email|--name|--tz|--currency|--https|--domain|--url|--acme-email|--ts-hostname)
      k="${1#--}"; PRESET[$k]="${2:?$1 needs a value}"; shift ;;
    --password-env) PRESET_PASSWORD="${!2:?$2 is empty}"; shift ;;
    --mail) PRESET[mail]="${2:?}"; shift ;;
    *) ARGS+=("$1") ;;
  esac
  shift
done
set -- "${ARGS[@]+"${ARGS[@]}"}"
cmd="${1:-help}"; [ $# -gt 0 ] && shift
case "$cmd" in
  install) cmd_install ;;
  status) cmd_status ;;
  logs) cmd_logs "$@" ;;
  restart) cmd_restart "$@" ;;
  endpoint) cmd_endpoint "$@" ;;
  token) cmd_token ;;
  backup) cmd_backup "$@" ;;
  restore) cmd_restore "$@" ;;
  update) cmd_update ;;
  _update) cmd__update ;;
  uninstall) cmd_uninstall ;;
  link) load_env; cmd_link "$@" ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
