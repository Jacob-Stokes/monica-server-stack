  "- - - - - 231,-,█ 231,-,█ 231,-,█ 231,-,█ 231,-,█ 236,231,▐ 236,-,█ 236,-,█ 236,231,▀ 231,-,█ 254,-,█ 236,254,▀ 236,-,█ 236,-,█ 236,254,▌ 254,-,█ 254,-,█ 254,-,█ 254,-,█ 254,-,█ - - - - -"
